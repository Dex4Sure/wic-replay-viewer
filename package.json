{
  "name": "wic-replay-viewer-ui",
  "private": true,
  "version": "0.6.2",
  "author": "Dex4Sure",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "npm run typecheck && vite build && node scripts/collect-error-report-symbols.mjs",
    "build:linux": "./scripts/build-appimage.sh",
    "build:windows": "node scripts/tauri.mjs build --ci --no-bundle",
    "build:windows-cross": "./scripts/build-windows-cross.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location .cache/prettier",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint",
    "lint:fix": "eslint . --fix",
    "licenses:check": "node scripts/third-party-notices.mjs check",
    "licenses:generate": "npm ci --no-audit --no-fund && cargo fetch --locked && node scripts/third-party-notices.mjs generate",
    "version:check": "node scripts/version.mjs check",
    "release:prepare": "./scripts/release-prepare.sh",
    "release:notes": "node scripts/version.mjs notes",
    "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/vue-tsc.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri": "node scripts/tauri.mjs",
    "build:appimage": "./scripts/build-appimage.sh"
  },
  "dependencies": {
    "@lucide/vue": "1.39.0",
    "@tanstack/vue-virtual": "3.13.36",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.12.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.12.0",
    "happy-dom": "20.8.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
