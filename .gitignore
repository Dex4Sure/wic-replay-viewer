# Deterministic output of tauri_build::build(), derived from
# src-tauri/capabilities/ and the plugin ACL definitions. The build emits
# desktop-schema.json plus one for whichever host it runs on, so tracking these
# records who built where rather than any shared contract.
/src-tauri/gen/schemas/

# Local absolute paths to a game installation and private replay corpora, used
# by the environment-gated tests. Machine-specific and never shared.
/.env

# Private research evidence, outputs, and host state
/local/
__pycache__/
*.pyc
/.env.*
!/.env.example

# Optional revision handoff for source archives without .git.
/.build-revision

# User-exported diagnostic evidence is not product source.
/src-tauri/errors/
