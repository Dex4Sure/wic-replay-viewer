# Absolute machine-local paths. Copy to .env; never commit the populated file.
WIC_GAME_INSTALL="/path/to/World in Conflict"
WIC_CUSTOM_MAPS="/path/to/Documents/World in Conflict/Downloaded/maps"

# Optional research evidence and analysis project. Paths are machine-local.
WIC_DATA_ROOT=/path/to/private-evidence
# Export this before launching Codex to reuse a project stored elsewhere.
# WIC_GHIDRA_PROJECT=/absolute/path/to/WiCProject.gpr
